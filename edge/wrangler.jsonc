{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sneat-media",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "routes": [{ "pattern": "media.sneat.co/m/*", "zone_name": "sneat.co" }],
  "vars": {
    "ORIGIN_BASE_URL": "https://api.sneat.app"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  }
}
